# App
NODE_ENV=development
APP_NAME="宠物医生 AI 医助"
APP_URL=http://localhost:5173
API_BASE_URL=http://localhost:3000

# Backend
PORT=3000
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Database
# Local MVP may use SQLite first, while keeping the schema portable to PostgreSQL.
DATABASE_PROVIDER=sqlite
DATABASE_URL=file:./dev.db
# If Prisma reports an empty schema engine error in a path with spaces or non-ASCII characters,
# temporarily use an absolute SQLite URL, for example:
# DATABASE_URL=file:/private/tmp/pet-doctor-ai-assistant-dev.db
# PostgreSQL example:
# DATABASE_PROVIDER=postgresql
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pet_doctor_ai_assistant

# Private file storage
STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=./storage/private
PRIVATE_FILE_SIGNING_SECRET=replace-with-private-file-secret
PRIVATE_FILE_URL_TTL_SECONDS=600
MAX_AUDIO_SIZE_MB=100
MAX_AUDIO_DURATION_SECONDS=1800

# Transcription provider
TRANSCRIPTION_PROVIDER=mock
TRANSCRIPTION_MODEL_NAME=mock-transcription-v1
DINGTALK_TRANSCRIPTION_API_KEY=
FEISHU_TRANSCRIPTION_APP_ID=
FEISHU_TRANSCRIPTION_APP_SECRET=
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=

# LLM provider
LLM_PROVIDER=mock
LLM_MODEL_NAME=mock-llm-v1
DEEPSEEK_API_KEY=
QWEN_API_KEY=

# Export
EXPORT_TEMP_DIR=./tmp/exports
