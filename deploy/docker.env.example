# MVP Docker environment template.
# Do not use this file directly for production. Copy it to deploy/docker.env,
# replace every placeholder secret, and keep deploy/docker.env out of Git.

NODE_ENV=production
PORT=3000
# Public H5 origin allowed by backend CORS. Replace with your real HTTPS domain.
CORS_ORIGIN=https://ai.example.com
# H5 Docker build should call backend through Nginx reverse proxy.
VITE_API_BASE_URL=/api

# Required: replace with a long random secret before any shared/demo/production deployment.
JWT_SECRET=replace-with-a-long-random-secret-for-docker-mvp
JWT_EXPIRES_IN=7d

DATABASE_PROVIDER=sqlite
DATABASE_URL=file:/app/data/dev.db

STORAGE_PROVIDER=local
LOCAL_STORAGE_DIR=/app/storage/private
# Required: replace with a long random secret before any shared/demo/production deployment.
PRIVATE_FILE_SIGNING_SECRET=replace-with-private-file-secret-for-docker-mvp
PRIVATE_FILE_URL_TTL_SECONDS=600
MAX_AUDIO_SIZE_MB=100
MAX_AUDIO_DURATION_SECONDS=1800

# For Docker MVP demo, mock keeps the full flow runnable without external vendors.
# For real business use, switch provider and fill the matching credentials below.
TRANSCRIPTION_PROVIDER=mock
TRANSCRIPTION_MODEL_NAME=mock-transcription-v1
DINGTALK_TRANSCRIPTION_API_KEY=
FEISHU_TRANSCRIPTION_APP_ID=
FEISHU_TRANSCRIPTION_APP_SECRET=
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=

LLM_PROVIDER=mock
LLM_MODEL_NAME=mock-llm-v1
DEEPSEEK_API_KEY=
QWEN_API_KEY=

EXPORT_TEMP_DIR=/app/tmp/exports
# Demo can use true to create demo_doctor / demo_password.
# Production must use false after real accounts are provisioned.
SEED_ON_START=true
